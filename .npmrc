# sanity-plugin-link-field@1.5.1 (latest) declares its peer range as
# `sanity ^3 || ^4 || ^5` and has not yet added ^6, but it runs fine on
# Sanity v6 (historically the plugin only bumps the peer range per major).
# legacy-peer-deps lets `npm install` / `npm ci` (incl. on Vercel) resolve
# despite that single stale peer. Revisit/remove once link-field ships v6.
legacy-peer-deps=true
