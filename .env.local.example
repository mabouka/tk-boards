NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_token_here

# Shared secret for the Sanity → /api/revalidate webhook (on-publish cache busting).
# Generate one with: openssl rand -base64 32
# Put the SAME value in the Sanity webhook "Secret" field (manage.sanity.io).
SANITY_REVALIDATE_SECRET=your_webhook_secret_here

# Email (Resend) — verification, password reset, contact form.
# Without RESEND_API_KEY, emails are logged to the server console (dev-testable).
RESEND_API_KEY=
EMAIL_FROM="TK Boards <onboarding@resend.dev>"
# Recipient for contact-form submissions.
CONTACT_EMAIL=

# Cloudflare Turnstile — contact form anti-spam (dash.cloudflare.com → Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — checkout + webhook. The webhook endpoint must subscribe to
# checkout.session.completed AND checkout.session.expired (the latter releases
# reserved stock). Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Invoicing needs no env: the seller's legal identity is edited in the Studio
# under "Société (facturation)". Until its legal name and tax id are filled in,
# invoicing stays disabled and no "Facture" link is shown.
